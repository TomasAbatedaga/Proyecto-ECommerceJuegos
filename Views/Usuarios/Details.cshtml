@model ECommerceJuegos.ViewModels.UsuarioResumenViewModel
@{ ViewData["Title"] = "Detalles del usuario"; }
<h1>Detalles del usuario</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Id</dt><dd class="col-sm-10">@Model.UsuarioId</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Rol</dt><dd class="col-sm-10">@Model.Rol</dd>
    <dt class="col-sm-2">Estado</dt><dd class="col-sm-10">@(Model.EstadoActivo ? "Activo" : "Inactivo")</dd>
</dl>
<div class="mb-3">
    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
    {
        <img src="@Model.AvatarUrl" alt="Avatar del usuario" class="rounded-circle" width="112" height="112" style="object-fit: cover;" />
    }
    else
    {
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-body-secondary" style="width:112px; height:112px;" role="img" aria-label="Usuario sin avatar">
            <i class="bi bi-person-circle" style="font-size:100px;" aria-hidden="true"></i>
        </span>
    }
</div>
<a asp-action="Edit" asp-route-id="@Model.UsuarioId" class="btn btn-outline-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
