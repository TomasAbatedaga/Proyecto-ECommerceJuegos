@model ECommerceJuegos.ViewModels.UsuariosIndexViewModel
@{ ViewData["Title"] = "Usuarios"; }

<h1 class="mb-4">Gestión de usuarios</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<a asp-action="Create" class="btn btn-gamer btn-sm mb-3"><i class="bi bi-person-plus-fill"></i> Crear nuevo</a>

@if (Model.TotalRegistros == 0)
{
    <p class="text-muted mt-3">No hay usuarios para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover align-middle border-secondary mt-3">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Usuarios)
            {
                <tr>
                    <td>@item.UsuarioId</td>
                    <td>@item.Email</td>
                    <td>@item.Rol</td>
                    <td>
                        @if(item.EstadoActivo) { <span class="badge bg-success">Activo</span> }
                        else { <span class="badge bg-danger">Inactivo</span> }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@item.UsuarioId" class="btn btn-icon btn-outline-info btn-sm" title="Detalles" aria-label="Detalles"><i class="bi bi-info-circle" aria-hidden="true"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.UsuarioId" class="btn btn-icon btn-outline-warning btn-sm" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                            @if (item.EstadoActivo)
                            {
                                <a asp-action="Delete" asp-route-id="@item.UsuarioId" class="btn btn-icon btn-outline-danger btn-sm" title="Desactivar" aria-label="Desactivar"><i class="bi bi-ban" aria-hidden="true"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<partial name="_Paginacion" model="Model" />
