@model ECommerceJuegos.ViewModels.UsuariosIndexViewModel
@{ ViewData["Title"] = "Usuarios"; }

<h1>Gestión de usuarios</h1>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<p><a asp-action="Create" class="btn btn-primary">Crear nuevo</a></p>
<table class="table table-striped">
    <thead><tr><th>Id</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Usuarios)
    {
        <tr>
            <td>@item.UsuarioId</td>
            <td>@item.Email</td>
            <td>@item.Rol</td>
            <td>@(item.EstadoActivo ? "Activo" : "Inactivo")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.UsuarioId" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Details" asp-route-id="@item.UsuarioId" class="btn btn-info btn-sm">Detalles</a>
                @if (item.EstadoActivo)
                {
                    <a asp-action="Delete" asp-route-id="@item.UsuarioId" class="btn btn-danger btn-sm">Desactivar</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<p>Total de usuarios: @Model.TotalRegistros</p>
@if (Model.TotalRegistros == 0)
{
    <p>No hay usuarios para mostrar.</p>
}
<nav aria-label="Paginación de usuarios">
    <ul class="pagination">
        @if (Model.TieneAnterior)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">Anterior</span></li>
        }
        <li class="page-item"><span class="page-link">@(Model.PaginaActual) / @Model.TotalPaginas</span></li>
        @if (Model.TieneSiguiente)
        {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">Siguiente</span></li>
        }
    </ul>
</nav>