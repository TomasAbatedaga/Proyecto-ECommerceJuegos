@model ECommerceJuegos.ViewModels.UsuarioResumenViewModel
@{ ViewData["Title"] = "Desactivar usuario"; }
<h1>Desactivar usuario</h1>
<p>¿Deseás desactivar este usuario? Su registro se conservará y no podrá iniciar sesión nuevamente.</p>
<dl class="row">
    <dt class="col-sm-2">Id</dt><dd class="col-sm-10">@Model.UsuarioId</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Rol</dt><dd class="col-sm-10">@Model.Rol</dd>
    <dt class="col-sm-2">Estado</dt><dd class="col-sm-10">@(Model.EstadoActivo ? "Activo" : "Inactivo")</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.UsuarioId" method="post">
    <button type="submit" class="btn btn-danger">Desactivar usuario</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>