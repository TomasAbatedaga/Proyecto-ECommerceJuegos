@{
    ViewData["Title"] = "Inicio";
}
<div class="container mt-4 mb-5">
    <div class="p-4 p-md-5 mb-5 rounded-4 shadow-lg text-center" style="background:linear-gradient(135deg, var(--card-bg) 0%, #2a0e00 100%); border:1px solid var(--border-dark);">
        <div class="container-fluid py-4">
            <h1 class="display-4 fw-bold mb-3">Tus juegos favoritos, <span style="color:var(--accent-color);">en un solo catálogo</span></h1>
            <p class="col-md-8 mx-auto fs-4 text-muted mb-5">Explorá juegos y software, realizá una compra simulada y consultá tus claves digitales en el historial. Proyecto académico sin procesamiento de pagos reales.</p>
            <a href="@Url.Action("Catalogo", "Productos")" class="btn btn-gamer btn-lg px-4 py-3 shadow">
                <i class="bi bi-controller me-2"></i> Explorar Catálogo
            </a>
        </div>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100 p-4 shadow-sm">
                <i class="bi bi-key-fill display-4 mb-3" style="color:var(--accent-color);"></i>
                <h2 class="h4 fw-bold">Claves en tu historial</h2>
                <p class="text-muted">Cuando completás una compra simulada con stock disponible, la clave queda en tu historial.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 p-4 shadow-sm">
                <i class="bi bi-bag-check display-4 mb-3" style="color:var(--accent-color);"></i>
                <h2 class="h4 fw-bold">Compra simulada</h2>
                <p class="text-muted">Ingresá con tu cuenta de Cliente para probar el recorrido de compra del proyecto.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 p-4 shadow-sm">
                <i class="bi bi-chat-square-text display-4 mb-3" style="color:var(--accent-color);"></i>
                <h2 class="h4 fw-bold">Reseñas de clientes</h2>
                <p class="text-muted">Calificá y comentá los productos que hayas comprado dentro de la aplicación.</p>
            </div>
        </div>
    </div>
</div>
