@model IList<Categoria>
@{ ViewData["Title"] = "Categorías"; }

<h1>Categorías</h1>

@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<a asp-action="Create" class="btn btn-gamer btn-sm mb-3"><i class="bi bi-plus-circle"></i> Crear categoría</a>

@if (Model.Count == 0) { <p>No hay categorías.</p> }
else {
<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle border-secondary mt-3">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model) {
            <tr>
                <td>@categoria.CategoriaId</td>
                <td>@categoria.Nombre</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@categoria.CategoriaId" class="btn btn-icon btn-sm btn-outline-info" title="Detalles" aria-label="Detalles"><i class="bi bi-info-circle" aria-hidden="true"></i></a>
                        <a asp-action="Edit" asp-route-id="@categoria.CategoriaId" class="btn btn-icon btn-sm btn-outline-warning" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                        <a asp-action="Delete" asp-route-id="@categoria.CategoriaId" class="btn btn-icon btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash" aria-hidden="true"></i></a>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
}
