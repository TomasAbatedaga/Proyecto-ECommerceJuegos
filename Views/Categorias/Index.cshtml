@model IList<Categoria>
@{ ViewData["Title"] = "Categorías"; }
<h1>Categorías</h1>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<a asp-action="Create" class="btn btn-primary mb-3">Crear categoría</a>
@if (Model.Count == 0) { <p>No hay categorías.</p> }
else {
<div class="table-responsive"><table class="table"><thead><tr><th>Id</th><th>Nombre</th><th>Acciones</th></tr></thead><tbody>
@foreach (var categoria in Model) {
<tr><td>@categoria.CategoriaId</td><td>@categoria.Nombre</td><td>
<a asp-action="Details" asp-route-id="@categoria.CategoriaId">Detalles</a> |
<a asp-action="Edit" asp-route-id="@categoria.CategoriaId">Editar</a> |
<a asp-action="Delete" asp-route-id="@categoria.CategoriaId">Eliminar</a>
</td></tr>
}
</tbody></table></div>
}
