@model ECommerceJuegos.ViewModels.ProductoListadoViewModel
<div class="row mb-3"><div class="col-md-4">
@if (!string.IsNullOrEmpty(Model.PortadaRuta)) { 
    <img src="@Model.PortadaRuta" alt="Portada de @Model.Nombre" class="img-fluid rounded shadow" style="max-height:400px; width: 100%; object-fit: cover;" /> 
}
else { 
    <div class="d-flex align-items-center justify-content-center rounded" style="background-color: var(--card-bg); height: 400px; border: 1px dashed var(--border-dark);">
        <span class="text-muted fs-4">Sin portada</span>
    </div> 
}