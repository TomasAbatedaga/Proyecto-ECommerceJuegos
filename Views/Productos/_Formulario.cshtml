@model ECommerceJuegos.ViewModels.ProductoFormViewModel
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="5"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" max="99999999.99" /><span asp-validation-for="Precio" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CategoriaId" class="form-label">Categoría</label>
<select asp-for="CategoriaId" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categorias, "CategoriaId", "Nombre"))" class="form-select"><option value="">Seleccionar categoría</option></select>
<span asp-validation-for="CategoriaId" class="text-danger"></span></div>
@if (Model.Categorias.Count == 0) { <p class="text-warning">Creá una categoría antes de guardar un producto.</p> }
@if (!string.IsNullOrEmpty(Model.PortadaRutaActual)) { <img src="@Model.PortadaRutaActual" alt="Portada actual" class="img-thumbnail mb-3" style="max-height:160px" /> }
<div class="mb-3"><label asp-for="Portada" class="form-label">Portada (opcional)</label><input asp-for="Portada" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" /><span asp-validation-for="Portada" class="text-danger"></span><p class="form-text">JPG, PNG o WebP. Máximo 5 MB. Sin archivo nuevo se conserva la portada actual.</p></div>
