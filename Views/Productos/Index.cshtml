@model ECommerceJuegos.ViewModels.ProductosIndexViewModel
@{ ViewData["Title"] = "Productos"; }

<h1>Productos</h1>

@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<a asp-action="Create" class="btn btn-gamer btn-sm mb-3"><i class="bi bi-plus-circle"></i> Crear producto</a>

@if (Model.Productos.Count == 0) { <p>No hay productos.</p> }
else {
<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle border-secondary mt-3">
        <thead>
            <tr>
                <th>Id</th>
                <th>Portada</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.Productos) {
            <tr>
                <td>@producto.ProductoId</td>
                <td>
                    @if (!string.IsNullOrEmpty(producto.PortadaRuta)) {
                        <img src="@producto.PortadaRuta" alt="Portada de @producto.Nombre" style="width:60px;height:80px;object-fit:contain" />
                    } else {
                        <span class="text-muted">Sin portada</span>
                    }
                </td>
                <td>@producto.Nombre</td>
                <td>@producto.CategoriaNombre</td>
                <td>@producto.Precio.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td>
                <td>@(producto.EstadoActivo ? "Activo" : "Inactivo")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@producto.ProductoId" class="btn btn-icon btn-sm btn-outline-info" title="Detalles" aria-label="Detalles"><i class="bi bi-info-circle" aria-hidden="true"></i></a>
                        <a asp-action="Edit" asp-route-id="@producto.ProductoId" class="btn btn-icon btn-sm btn-outline-warning" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                        @if (producto.EstadoActivo) {
                            <a asp-action="Delete" asp-route-id="@producto.ProductoId" class="btn btn-icon btn-sm btn-outline-danger" title="Desactivar" aria-label="Desactivar"><i class="bi bi-ban" aria-hidden="true"></i></a>
                        }
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
}
<partial name="_Paginacion" model="Model" />
