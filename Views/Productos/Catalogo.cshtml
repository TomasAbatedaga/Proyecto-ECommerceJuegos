@model ECommerceJuegos.ViewModels.ProductosIndexViewModel
@{
    ViewData["Title"] = "Catálogo de Juegos";
}

<!-- Banner -->
<div class="mb-5 text-center" style="background: linear-gradient(0deg, rgba(18,20,24,1) 0%, rgba(247,85,0,0.2) 100%); padding: 3rem 0; border-radius: 10px;">
    <h1 class="display-4 fw-bold">Ofertas Destacadas</h1>
    <p class="lead text-muted">Las mejores claves digitales al instante.</p>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var producto in Model.Productos)
    {
        <div class="col">
            <div class="card game-card h-100">
                <!-- Portada -->
                @if (!string.IsNullOrEmpty(producto.PortadaRuta))
                {
                    <img src="@producto.PortadaRuta" class="card-img-top" alt="@producto.Nombre">
                }
                else
                {
                    <div class="game-card-placeholder d-flex align-items-center justify-content-center" style="background-color: #1a1c22;">
                        <span class="text-muted">Sin imagen</span>
                    </div>
                }

                <div class="card-body d-flex flex-column">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">@producto.CategoriaNombre</small>
                    <h5 class="card-title mt-1 mb-3 text-truncate" title="@producto.Nombre">@producto.Nombre</h5>
                    
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-end mb-3">
                            <span class="price-tag">@producto.Precio.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</span>
                            <span class="badge bg-dark border border-secondary text-light">Global Key</span>
                        </div>
                        
                        <a href="@Url.Action("Detalle", "Productos", new { id = producto.ProductoId })" class="btn btn-gamer w-100">
                            <i class="bi bi-cart-plus"></i> Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- La paginación (asegúrate de que los botones de paginación tengan estilo oscuro) -->
@if (Model.TotalPaginas > 1)
{
    <nav class="mt-5">
        <ul class="pagination justify-content-center" data-bs-theme="dark">
            <!-- Lógica de paginación existente... -->
        </ul>
    </nav>
}