@model ECommerceJuegos.ViewModels.ProductosIndexViewModel

<div class="d-flex justify-content-between align-items-center mt-4 border-top border-secondary pt-3">
    <span class="text-muted">Página @Model.PaginaActual de @Model.TotalPaginas &middot; @Model.TotalRegistros productos</span>
    
    <nav aria-label="Páginas de productos" data-bs-theme="dark">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.TieneAnterior ? "" : "disabled")">
                <a class="page-link" asp-action="@ViewContext.RouteData.Values["action"]" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
            </li>
            
            <li class="page-item disabled">
                <span class="page-link">@Model.PaginaActual / @Model.TotalPaginas</span>
            </li>
            
            <li class="page-item @(Model.TieneSiguiente ? "" : "disabled")">
                <a class="page-link" asp-action="@ViewContext.RouteData.Values["action"]" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>