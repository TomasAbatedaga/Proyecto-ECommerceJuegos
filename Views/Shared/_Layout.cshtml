@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string targetController, string? targetAction = null) =>
        string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase) &&
        (targetAction == null || string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase));
    var catalogoActivo = IsActive("Productos", "Catalogo") || IsActive("Productos", "Detalle");
    var productosActivos = IsActive("Productos") && !catalogoActivo;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoreJuegos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto-ECommerceJuegos.styles.css" asp-append-version="true" />
</head>
<body data-bs-theme="dark">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-gamer box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color: var(--accent-color);">Store</span>Juegos
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse d-lg-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center flex-lg-wrap">
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Index") ? "active" : "")" aria-current="@(IsActive("Home", "Index") ? "page" : null)" asp-controller="Home" asp-action="Index"><i class="bi bi-house" aria-hidden="true"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(catalogoActivo ? "active" : "")" aria-current="@(catalogoActivo ? "page" : null)" asp-controller="Productos" asp-action="Catalogo"><i class="bi bi-controller" aria-hidden="true"></i> Catálogo</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- menu del admin -->
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link @(IsActive("Categorias") ? "active" : "")" aria-current="@(IsActive("Categorias") ? "page" : null)" asp-controller="Categorias" asp-action="Index"><i class="bi bi-tags" aria-hidden="true"></i> Categorías</a></li>
                                <li class="nav-item"><a class="nav-link @(productosActivos ? "active" : "")" aria-current="@(productosActivos ? "page" : null)" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam" aria-hidden="true"></i> Productos</a></li>
                                <li class="nav-item"><a class="nav-link @(IsActive("Usuarios") ? "active" : "")" aria-current="@(IsActive("Usuarios") ? "page" : null)" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i> Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link @(IsActive("ClavesDigitales") ? "active" : "")" aria-current="@(IsActive("ClavesDigitales") ? "page" : null)" asp-controller="ClavesDigitales" asp-action="Index"><i class="bi bi-key" aria-hidden="true"></i> Claves Digitales</a></li>
                            }

                            <!-- menu del cliente -->
                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item"><a class="nav-link @(IsActive("MisCompras") ? "active" : "")" aria-current="@(IsActive("MisCompras") ? "page" : null)" asp-controller="MisCompras" asp-action="Index"><i class="bi bi-bag-check" aria-hidden="true"></i> Mis Compras</a></li>
                            }

                            <li class="nav-item ms-lg-auto">
                                <a class="nav-link navbar-profile" asp-controller="Usuarios" asp-action="Perfil" title="Mi perfil" aria-label="Mi perfil"><i class="bi bi-person-circle fs-4" aria-hidden="true"></i></a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn nav-link text-danger fw-bold"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-auto">
                                <a class="nav-link @(IsActive("Usuarios", "Login") ? "active" : "")" aria-current="@(IsActive("Usuarios", "Login") ? "page" : null)" asp-controller="Usuarios" asp-action="Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Login</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="nav-link @(IsActive("Usuarios", "Registro") ? "active" : "")" aria-current="@(IsActive("Usuarios", "Registro") ? "page" : null)" asp-controller="Usuarios" asp-action="Registro"><i class="bi bi-person-plus" aria-hidden="true"></i> Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5 py-3" style="border-top: 1px solid var(--border-dark); background-color: var(--bg-color);">
        <div class="container text-center">
            &copy; 2026 - StoreJuegos - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--accent-color); text-decoration: none;">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
