<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoreJuegos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto-ECommerceJuegos.styles.css" asp-append-version="true" />
</head>
<body data-bs-theme="dark">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-gamer box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color: var(--accent-color);">Store</span>Juegos
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse d-lg-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center flex-lg-wrap">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Productos" asp-action="Catalogo">Catálogo</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- menu del admin -->
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="ClavesDigitales" asp-action="Index">ClavesDigitales</a></li>
                            }

                            <!-- menu del cliente -->
                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="MisCompras" asp-action="Index">Mis Compras</a></li>
                            }

                            <li class="nav-item ms-lg-auto">
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Perfil">Mi perfil</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link navbar-email text-light fw-bold" title="@User.Identity.Name">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn nav-link text-danger fw-bold">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-auto">
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-gamer text-white px-4" asp-controller="Usuarios" asp-action="Registro">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-5 py-3" style="border-top: 1px solid var(--border-dark); background-color: var(--bg-color);">
        <div class="container text-center">
            &copy; 2026 - StoreJuegos - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--accent-color); text-decoration: none;">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
