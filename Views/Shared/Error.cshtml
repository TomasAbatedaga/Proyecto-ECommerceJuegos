@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1 class="text-danger">No se pudo completar la solicitud</h1>
<p>Ocurrió un error al procesar la operación. Intentá nuevamente más tarde.</p>
@if (Model.ShowRequestId)
{
    <p><strong>Identificador de solicitud:</strong> <code class="text-break">@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver al inicio</a>
