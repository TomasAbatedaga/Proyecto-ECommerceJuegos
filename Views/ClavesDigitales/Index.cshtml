@{
    ViewData["Title"] = "Stock de Claves Digitales";
}

<div id="appVue" class="container mt-4">
    @Html.AntiForgeryToken()
    <h2>Administración de Stock de Claves</h2>
    <hr />

    <button class="btn btn-primary mb-3" @@click="abrirModal(null)" :disabled="ocupado">+ Nueva Clave</button>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>
    <div v-if="exito" class="alert alert-success">{{ exito }}</div>

    <table class="table table-bordered table-hover mt-2">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Producto ID</th>
                <th>Código</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="c in claves" :key="c.claveDigitalId">
                <td>{{ c.claveDigitalId }}</td>
                <td>{{ c.productoId }}</td>
                <td>{{ c.codigo }}</td>
                <td>
                    <span :class="c.estado === 'Disponible' ? 'badge bg-success' : 'badge bg-secondary'">
                        {{ c.estado }}
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-warning me-2" @@click="abrirModal(c)" :disabled="c.estado === 'Vendida' || ocupado">Editar</button>
                    <button class="btn btn-sm btn-danger" @@click="eliminar(c.claveDigitalId)" :disabled="c.estado === 'Vendida' || ocupado">Eliminar</button>
                </td>
            </tr>
            <tr v-if="claves.length === 0">
                <td colspan="5" class="text-center">No hay claves registradas.</td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex align-items-center gap-3 mb-3">
        <button class="btn btn-outline-primary" @@click="cargarTabla(paginaActual - 1)"
                :disabled="ocupado || cargando || paginaActual <= 1">Anterior</button>
        <span>Página {{ paginaActual }} de {{ totalPaginas }} · Total: {{ totalRegistros }} claves</span>
        <button class="btn btn-outline-primary" @@click="cargarTabla(paginaActual + 1)"
                :disabled="ocupado || cargando || paginaActual >= totalPaginas">Siguiente</button>
    </div>

    <div class="modal" tabindex="-1" :class="{ 'd-block': modalVisible }" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ editando ? 'Editar Clave' : 'Nueva Clave' }}</h5>
                    <button type="button" class="btn-close" @@click="cerrarModal"></button>
                </div>
                <div class="modal-body">

                    <div class="mb-3" v-if="!editando">
                        <label class="form-label">Buscar Producto (min. 2 letras)</label>
                        <input type="text" class="form-control" v-model="busqueda" @@input="buscarAjax" placeholder="Ej: GTA" />
                        <ul class="list-group mt-2" v-if="resultados.length > 0">
                            <li class="list-group-item list-group-item-action" style="cursor:pointer;"
                                v-for="p in resultados" :key="p.productoId"
                                @@click="seleccionarProducto(p)">
                                {{ p.nombre }} (ID: {{ p.productoId }})
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Producto ID</label>
                        <input type="number" class="form-control" v-model="form.productoId" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Código Digital</label>
                        <input type="text" class="form-control" v-model="form.codigo" maxlength="255" placeholder="XXXX-XXXX-XXXX-XXXX" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @@click="cerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @@click="guardar" :disabled="ocupado || !form.productoId || !form.codigo.trim()">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        const { createApp, ref, computed, onMounted } = Vue;

        createApp({
            setup() {
                const claves = ref([]);
                const modalVisible = ref(false);
                const editando = ref(false);
                const error = ref('');
                const exito = ref('');
                const busqueda = ref('');
                const resultados = ref([]);
                const form = ref({ claveDigitalId: 0, productoId: null, codigo: '' });
                const paginaActual = ref(1);
                const totalPaginas = ref(1);
                const totalRegistros = ref(0);
                const guardando = ref(false);
                const eliminando = ref(false);
                const cargando = ref(false);
                const ocupado = computed(() => guardando.value || eliminando.value);
                const token = document.querySelector('#appVue input[name="__RequestVerificationToken"]').value;
                let ultimaBusqueda = 0;

                const pedirJson = async (url, opciones = {}) => {
                    let res;
                    try {
                        res = await fetch(url, opciones);
                    } catch {
                        throw new Error('No se pudo conectar con el servidor. Intentá nuevamente.');
                    }
                    if (res.redirected)
                        throw new Error('La sesión no permite esta operación. Volvé a iniciar sesión.');
                    const esJson = (res.headers.get('content-type') || '').includes('application/json');
                    let datos = null;
                    if (esJson) {
                        try { datos = await res.json(); }
                        catch { throw new Error('El servidor devolvió una respuesta inválida.'); }
                    }
                    if (!res.ok) {
                        const mensaje = res.status === 400
                            ? 'La solicitud no es válida o la sesión venció. Actualizá la página.'
                            : res.status === 401 || res.status === 403
                                ? 'No tenés autorización para esta operación.'
                                : 'No se pudo completar la operación. Intentá nuevamente.';
                        throw new Error(datos?.mensaje || mensaje);
                    }
                    if (!esJson) throw new Error('El servidor devolvió una respuesta inesperada.');
                    return datos;
                };

                const cargarTabla = async (pagina = paginaActual.value) => {
                    cargando.value = true;
                    try {
                        const datos = await pedirJson('/ClavesDigitales/Listar?pagina=' + pagina);
                        claves.value = datos.items;
                        paginaActual.value = datos.paginaActual;
                        totalPaginas.value = datos.totalPaginas;
                        totalRegistros.value = datos.totalRegistros;
                        // Una eliminación concurrente puede vaciar la página tras el COUNT.
                        if (claves.value.length === 0 && paginaActual.value > 1)
                            await cargarTabla(paginaActual.value - 1);
                    } catch (e) {
                        error.value = e.message;
                    } finally {
                        cargando.value = false;
                    }
                };

                const buscarAjax = async () => {
                    const solicitud = ++ultimaBusqueda;
                    const texto = busqueda.value.trim();
                    if (texto.length < 2) {
                        resultados.value = [];
                        return;
                    }
                    try {
                        const datos = await pedirJson('/ClavesDigitales/BuscarProductos?q=' + encodeURIComponent(texto));
                        if (solicitud === ultimaBusqueda) resultados.value = datos;
                    } catch (e) {
                        if (solicitud === ultimaBusqueda) {
                            resultados.value = [];
                            error.value = e.message;
                        }
                    }
                };

                const seleccionarProducto = (p) => {
                    ++ultimaBusqueda;
                    form.value.productoId = p.productoId;
                    busqueda.value = p.nombre;
                    resultados.value = [];
                };

                const abrirModal = (c) => {
                    if (ocupado.value) return;
                    ++ultimaBusqueda;
                    error.value = '';
                    exito.value = '';
                    editando.value = !!c;
                    busqueda.value = '';
                    resultados.value = [];
                    form.value = c
                        ? { claveDigitalId: c.claveDigitalId, productoId: c.productoId, codigo: c.codigo }
                        : { claveDigitalId: 0, productoId: null, codigo: '' };
                    modalVisible.value = true;
                };

                const cerrarModal = () => {
                    if (ocupado.value) return;
                    ++ultimaBusqueda;
                    modalVisible.value = false;
                };

                const guardar = async () => {
                    if (ocupado.value) return;
                    guardando.value = true;
                    error.value = '';
                    exito.value = '';
                    const eraEdicion = editando.value;
                    const datos = eraEdicion
                        ? { claveDigitalId: form.value.claveDigitalId, codigo: form.value.codigo }
                        : { productoId: form.value.productoId, codigo: form.value.codigo };
                    try {
                        const respuesta = await pedirJson(eraEdicion ? '/ClavesDigitales/Editar' : '/ClavesDigitales/Crear', {
                            method: eraEdicion ? 'PUT' : 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify(datos)
                        });
                        exito.value = respuesta.mensaje;
                        modalVisible.value = false;
                        ++ultimaBusqueda;
                        await cargarTabla(eraEdicion ? paginaActual.value : 1);
                    } catch (e) {
                        error.value = e.message;
                    } finally {
                        guardando.value = false;
                    }
                };

                const eliminar = async (id) => {
                    if (ocupado.value || !confirm('¿Eliminar clave de forma permanente?')) return;
                    eliminando.value = true;
                    error.value = '';
                    exito.value = '';
                    try {
                        const respuesta = await pedirJson('/ClavesDigitales/Eliminar/' + id, {
                            method: 'DELETE',
                            headers: { 'RequestVerificationToken': token }
                        });
                        exito.value = respuesta.mensaje;
                        await cargarTabla();
                    } catch (e) {
                        error.value = e.message;
                    } finally {
                        eliminando.value = false;
                    }
                };

                onMounted(() => cargarTabla());

                return {
                    claves, modalVisible, editando, error, exito,
                    busqueda, resultados, form, buscarAjax, seleccionarProducto,
                    abrirModal, cerrarModal, guardar, eliminar, cargarTabla,
                    paginaActual, totalPaginas, totalRegistros, ocupado, cargando
                };
            }
        }).mount('#appVue');
    </script>
}
