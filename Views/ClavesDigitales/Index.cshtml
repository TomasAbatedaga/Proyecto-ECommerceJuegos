@{
    ViewData["Title"] = "Stock de Claves Digitales";
}

<div id="appVue" class="container mt-4">
    @Html.AntiForgeryToken()
    <h2>Administración de Stock de Claves</h2>
    <hr />

    <button class="btn btn-gamer btn-sm mb-3" @@click="abrirModal(null)" :disabled="ocupado">+ Nueva Clave</button>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>
    <div v-if="exito" class="alert alert-success">{{ exito }}</div>

    <div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle border-secondary mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Producto ID</th>
                <th>Código</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="c in claves" :key="c.claveDigitalId">
                <td>{{ c.claveDigitalId }}</td>
                <td>{{ c.productoId }}</td>
                <td>{{ c.codigo }}</td>
                <td>
                    <span :class="c.estado === 'Disponible' ? 'badge bg-success' : 'badge bg-secondary'">
                        {{ c.estado }}
                    </span>
                </td>
                <td>
                    <button class="btn btn-icon btn-sm btn-outline-warning me-2" @@click="abrirModal(c)" :disabled="c.estado === 'Vendida' || ocupado" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                    <button class="btn btn-icon btn-sm btn-outline-danger" @@click="eliminar(c.claveDigitalId)" :disabled="c.estado === 'Vendida' || ocupado" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </td>
            </tr>
            <tr v-if="claves.length === 0">
                <td colspan="5" class="text-center">No hay claves registradas.</td>
            </tr>
        </tbody>
    </table>
    </div>
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mt-4 border-top border-secondary pt-3">
        <span class="text-muted">Página {{ paginaActual }} de {{ totalPaginas }} &middot; Total: {{ totalRegistros }}</span>

        <nav aria-label="Navegación de claves" data-bs-theme="dark">
            <ul class="pagination flex-wrap mb-0">
                <li class="page-item" :class="{ disabled: paginaActual <= 1 || ocupado || cargando }">
                    <button type="button" class="page-link" @@click="cargarTabla(paginaActual - 1)" :disabled="paginaActual <= 1 || ocupado || cargando">Anterior</button>
                </li>

                <li class="page-item active" aria-current="page">
                    <span class="page-link">{{ paginaActual }}</span>
                </li>

                <li class="page-item" :class="{ disabled: paginaActual >= totalPaginas || totalPaginas === 0 || ocupado || cargando }">
                    <button type="button" class="page-link" @@click="cargarTabla(paginaActual + 1)" :disabled="paginaActual >= totalPaginas || totalPaginas === 0 || ocupado || cargando">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>

    <div class="modal" data-bs-theme="dark" tabindex="-1" :class="{ 'd-block': modalVisible }" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ editando ? 'Editar Clave' : 'Nueva Clave' }}</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @@click="cerrarModal"></button>
                </div>
                <div class="modal-body">

                    <div class="mb-3" v-if="!editando">
                        <label class="form-label">Buscar Producto (min. 2 letras)</label>
                        <input type="text" class="form-control" v-model="busqueda" @@input="buscarAjax" placeholder="Ej: GTA" />
                        <ul class="list-group mt-2" v-if="resultados.length > 0">
                            <li class="list-group-item list-group-item-action" style="cursor:pointer;"
                                v-for="p in resultados" :key="p.productoId"
                                @@click="seleccionarProducto(p)">
                                {{ p.nombre }} (ID: {{ p.productoId }})
                            </li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Producto ID</label>
                        <input type="number" class="form-control" v-model="form.productoId" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Código Digital</label>
                        <input type="text" class="form-control" v-model="form.codigo" maxlength="255" placeholder="XXXX-XXXX-XXXX-XXXX" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @@click="cerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-gamer" @@click="guardar" :disabled="ocupado || !form.productoId || !form.codigo.trim()">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        Vue.createApp({
            data() {
                return {
                    claves: [],
                    modalVisible: false,
                    editando: false,
                    error: '',
                    exito: '',
                    busqueda: '',
                    resultados: [],
                    form: { claveDigitalId: 0, productoId: null, codigo: '' },
                    paginaActual: 1,
                    totalPaginas: 1,
                    totalRegistros: 0,
                    guardando: false,
                    eliminando: false,
                    cargando: false,
                    token: ''
                };
            },
            computed: {
                ocupado() {
                    return this.guardando || this.eliminando;
                }
            },
            methods: {
                async pedirJson(url, opciones = {}) {
                    const res = await fetch(url, opciones);
                    if (res.redirected)
                        throw new Error('La sesión no permite esta operación. Volvé a iniciar sesión.');
                    if (!(res.headers.get('content-type') || '').includes('application/json'))
                        throw new Error('El servidor devolvió una respuesta inesperada. Actualizá la página.');
                    const datos = await res.json();
                    if (!res.ok)
                        throw new Error(datos.mensaje || 'No se pudo completar la operación.');
                    return datos;
                },
                async cargarTabla(pagina = this.paginaActual) {
                    this.cargando = true;
                    try {
                        const datos = await this.pedirJson('/ClavesDigitales/Listar?pagina=' + pagina);
                        this.claves = datos.items;
                        this.paginaActual = datos.paginaActual;
                        this.totalPaginas = datos.totalPaginas;
                        this.totalRegistros = datos.totalRegistros;
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },
                async buscarAjax() {
                    const texto = this.busqueda.trim();
                    if (texto.length < 2) {
                        this.resultados = [];
                        return;
                    }
                    try {
                        this.resultados = await this.pedirJson('/ClavesDigitales/BuscarProductos?q=' + encodeURIComponent(texto));
                    } catch (e) {
                        this.resultados = [];
                        this.error = e.message;
                    }
                },
                seleccionarProducto(p) {
                    this.form.productoId = p.productoId;
                    this.busqueda = p.nombre;
                    this.resultados = [];
                },
                abrirModal(c) {
                    if (this.ocupado) return;
                    this.error = '';
                    this.exito = '';
                    this.editando = !!c;
                    this.busqueda = '';
                    this.resultados = [];
                    this.form = c
                        ? { claveDigitalId: c.claveDigitalId, productoId: c.productoId, codigo: c.codigo }
                        : { claveDigitalId: 0, productoId: null, codigo: '' };
                    this.modalVisible = true;
                },
                cerrarModal() {
                    if (!this.ocupado) this.modalVisible = false;
                },
                async guardar() {
                    if (this.ocupado) return;
                    this.guardando = true;
                    this.error = '';
                    this.exito = '';
                    const datos = this.editando
                        ? { claveDigitalId: this.form.claveDigitalId, codigo: this.form.codigo }
                        : { productoId: this.form.productoId, codigo: this.form.codigo };
                    try {
                        const respuesta = await this.pedirJson(this.editando ? '/ClavesDigitales/Editar' : '/ClavesDigitales/Crear', {
                            method: this.editando ? 'PUT' : 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.token },
                            body: JSON.stringify(datos)
                        });
                        this.exito = respuesta.mensaje;
                        this.modalVisible = false;
                        await this.cargarTabla(this.editando ? this.paginaActual : 1);
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.guardando = false;
                    }
                },
                async eliminar(id) {
                    if (this.ocupado || !confirm('¿Eliminar clave de forma permanente?')) return;
                    this.eliminando = true;
                    this.error = '';
                    this.exito = '';
                    try {
                        const respuesta = await this.pedirJson('/ClavesDigitales/Eliminar/' + id, {
                            method: 'DELETE',
                            headers: { 'RequestVerificationToken': this.token }
                        });
                        this.exito = respuesta.mensaje;
                        await this.cargarTabla();
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.eliminando = false;
                    }
                }
            },
            mounted() {
                this.token = document.querySelector('#appVue input[name="__RequestVerificationToken"]').value;
                this.cargarTabla();
            }
        }).mount('#appVue');
    </script>
}
